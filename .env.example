# ---- MiniMax（识图 + 文本，复用 mmx CLI 同一把 key）----
MINIMAX_API_KEY=sk-replace-me
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# ---- 后端 ----
# SQLite 单文件；单用户零运维
DATABASE_URL=sqlite:///~/.outfit-ai/outfit_ai.db
UPLOAD_DIR=~/.outfit-ai/uploads
# 单图/请求体上限（MiniMax: 图 ≤10MB, body ≤64MB）
MAX_IMAGE_BYTES=10485760

# ---- CORS（v0 H5 联调；上线收紧到正式域名）----
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- 单用户占位（v0 不做多用户鉴权）----
USER_ID=local
