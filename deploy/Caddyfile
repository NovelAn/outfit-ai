{$DOMAIN} {
    encode gzip

    handle /api/* {
        reverse_proxy app:8000
    }

    handle /media/* {
        reverse_proxy app:8000
    }

    handle /health {
        reverse_proxy app:8000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
